{
  "name": "Portal Saúde Ubatuba",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "Portal", "onAutoForward": "openBrowser" } },
  "containerEnv": {
    "DATABASE_URL": "postgres://portal:portal@localhost:5432/portal",
    "SITE_URL": "http://localhost:3000",
    "SEED_ADMIN_NAME": "Administrador",
    "SEED_ADMIN_EMAIL": "admin@example.com",
    "SEED_ADMIN_PASSWORD": "Troque-esta-senha-123"
  },
  "postCreateCommand": "npm install && sleep 5 && npm run db:migrate && npm run db:seed",
  "postAttachCommand": "npm run dev"
}
