# Banco (qualquer PostgreSQL, inclusive Supabase)
DATABASE_URL=postgres://portal:portal@localhost:5432/portal
# URL pública do site (sitemap, Open Graph)
SITE_URL=http://localhost:3000
# Primeiro administrador criado por `npm run db:seed`
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Armazenamento de uploads (disco local)
STORAGE_DIR=./storage
# E-mail do formulário de contato (opcional; sem SMTP a mensagem fica só no painel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=
# Anti-spam opcional (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Instagram Graph API opcional (sem token, cadastro manual)
INSTAGRAM_ACCESS_TOKEN=
# Monitoramento de erros opcional (DSN externo)
ERROR_WEBHOOK_URL=
